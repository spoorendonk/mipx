CompileFlags:
  CompilationDatabase: build/
  # As .clang-tidy's ExtraArgs: clang 22 calls Catch2's __COUNTER__ a C2y
  # extension, an error under the build's -Wpedantic -Werror (#262). A clangd
  # before 19 does not know the flag; the second keeps it from erroring too.
  Add: [-Wno-c2y-extensions, -Wno-unknown-warning-option]
Diagnostics:
  UnusedIncludes: Strict
