# ...but the small hand-written fixtures are part of the repo. The ignores
# above are for downloaded instance sets and test scratch files.
!tests/data/tiny.mps
!tests/data/empty_model.mps
!tests/data/malformed.mps
# The MPS extension-section fixtures of #254, one per section.
!tests/data/mps_*.mps
# LP sequences for replay tests, including the public CommaLab grid1 (#267).
!tests/data/lpseq/**/*.mps
# The second column-generation master of the public CommaLab grid2 is
# CpuAugmented's regression LP (#270).
!tests/data/grid2_master_0001.mps
# Netlib cplex2, infeasible by 1.6e-11 per row: crossover's regression LP
# for a rigorous Farkas ray (#408).
!tests/data/cplex2.mps
# Legacy first-master downloads (#331).
tests/data/cg_masters/*
# Later masters are generated (#358); their reference objectives are tracked.
tests/data/cg_masters_later/*
!tests/data/cg_masters_later/cg_masters.solu

