{
  "_note": "Git hooks live in .githooks/ (core.hooksPath); pre-commit formats and tests, commit-msg enforces conventional commits, pre-push runs the clean build, tests and linters. Claude hooks below are in .claude/hooks/.",
  "permissions": {
    "allow": [
      "Bash(*&&*)",
      "Bash(*)",
      "Bash(*;*)",
      "Bash(*<*)",
      "Bash(*<<*)",
      "Bash(*>*)",
      "Bash(*>>*)",
      "Bash(*|*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "LSP(*)",
      "Read(*)",
      "Search(*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(chmod -R 777 *)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Read(./.env*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch-create.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-venv.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-grep.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh"
  }
}
