---
Checks: >
  -*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

WarningsAsErrors: ''
# First-party headers only, set explicitly: clang-tidy 22's default is every
# non-system header, and FetchContent's `_deps/` (Catch2, nanobind) has its
# own `src/` and `include/` directories (#262).
HeaderFilterRegex: '/(include/mipx|src|tests)/'
ExcludeHeaderFilterRegex: '/_deps/'
# The build compiles with GCC and -Wpedantic -Werror; clang 22 reports
# __COUNTER__, which Catch2's TEST_CASE expands to, as a C2y extension, and
# -Werror makes that an error in every test source. GCC does not (#262).
ExtraArgs: ['-Wno-c2y-extensions']
FormatStyle: file
